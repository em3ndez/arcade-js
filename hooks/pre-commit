#!/usr/bin/env bash
# Pre-commit gates: understanding_gate, names_consistency, comment_gate, review_gate.
# Each refuses the commit rather than warning. Do NOT --no-verify around them.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
python3 "$root/tools/understanding_gate.py" check
python3 "$root/tools/names_consistency.py" check
python3 "$root/tools/comment_gate.py" check
exec python3 "$root/tools/review_gate.py" check
