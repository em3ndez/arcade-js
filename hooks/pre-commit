#!/usr/bin/env bash
# Pre-commit gates. Do NOT --no-verify around these — that defeats the rules they enforce.
#   1. understanding_gate  — an understanding pass must rewrite the game's mechanisms.md in the SAME
#        commit as its renames, and the map must reference no retired names.  tools/understanding_gate.py
#   2. names_consistency  — ram.js is the single source of truth for whether a cell is named;
#        no staged prose (mechanisms.md / routine comment) may call a named cell "hex/unnamed".
#        tools/names_consistency.py
#   3. review_gate        — every commit's staged changes carry an independent PASS review token
#        bound to their exact content.  tools/review_gate.py
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
python3 "$root/tools/understanding_gate.py" check
python3 "$root/tools/names_consistency.py" check
exec python3 "$root/tools/review_gate.py" check
