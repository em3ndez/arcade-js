#!/usr/bin/env bash
# Pre-push gate: never push a red tree. Runs the full unit suite once per push
# and BLOCKS the push if it fails -- the backstop the review gate cannot give (a review
# token attests a review happened, not that the suite is green; a partial-suite pass once
# masked a red translated test that got pushed). --no-verify bypasses it; don't.
repo="$(git rev-parse --show-toplevel)" || { echo "[pre-push] not a git repo -- blocking" >&2; exit 1; }
cd "$repo" || { echo "[pre-push] cannot cd to repo -- blocking" >&2; exit 1; }
# A SPIN IN THE IDIOMATIC LAYER CANNOT BE BOUNDED FROM INSIDE, so it is bounded from out here.
# runCycleFree's stepBudget counts m.step calls; idiomatic routines are cycle-free and never call
# it, so the budget bounds the TRANSLATED arm -- faithful transcription of terminating ROM code,
# the arm least able to spin -- and is blind to the arm most able to. node --test's --test-timeout
# does not help either: a synchronous loop never yields, so no timer in that process ever runs
# (measured: --test-timeout=5000 against a `for(;;){}` had to be killed externally at 40s).
# Hence a process-level kill, the one bound the code under test cannot decline to call.
# A hanging gate is worse than a failing one: CI waits, no verdict is produced, and it looks
# exactly like a slow machine -- the failure mode people wait through instead of investigating.
# The cap bounds a spin; it must not bound a healthy run. Same green tree, 2026-08-08: 508s and
# 565s at load ~150-200, and 1056s with the load unrecorded -- so it varies >2x between runs, and
# 600 sat inside that spread. 2400 is ~2.3x the slowest; a spin now reports in 40 min, not 10.
# ⚠ Re-measure as it grows past 9624 tests, and RECORD THE LOAD; the cap-setting sample has none.
# SUITE_TIMEOUT=<seconds> overrides -- not a bypass, the suite still runs whole and must pass.
SUITE_TIMEOUT="${SUITE_TIMEOUT:-2400}"

# ⚠ KEEP UNDER 900 -- rom_guard_check.mjs bounds its own run at `timeout: 900_000` MILLIseconds
# and this is SECONDS. If the inner bound fires first, rom_guard exits 1 not 124 and the clone
# hang below is misreported as "RED for a stranger", branch unreachable. Measured 37-54s.
GUARD_TIMEOUT="${GUARD_TIMEOUT:-600}"
runner=""
for t in timeout gtimeout; do command -v "$t" >/dev/null 2>&1 && { runner="$t"; break; }; done
if [ -z "$runner" ]; then
  echo "[pre-push] WARNING: no timeout(1) found -- running the suite UNBOUNDED." >&2
  echo "[pre-push] a spin in an idiomatic routine will hang this push with no verdict." >&2
fi
# No runtime estimate here on purpose -- a hand-maintained one goes stale and misleads.
# Scope the suite: a push touching ONLY one game's dir runs that game's tests plus ALL shared tests
# (core/boards/tools/web) and skips the OTHER games -- safe because games are independent. Anything
# shared, a second game, or an unknowable range runs the FULL suite. Fails safe. PREPUSH_FULL=1 forces full.
# rom-guard below still runs whole -- it is cheap (a no-ROM clone mostly skips) and guards ALL games.
scope="FULL"
if [ -z "${PREPUSH_FULL:-}" ]; then
  # No `case` inside this $() -- bash 3.2 (macOS /bin/bash) misparses case-in-command-subst; ${sha//0/} tests all-zeros.
  changed="$(while read -r _lr lsha _rr rsha; do
    [ -z "$lsha" ] && continue
    [ -z "${lsha//0/}" ] && continue
    if [ -n "${rsha//0/}" ]; then
      git diff --name-only "$rsha" "$lsha" 2>/dev/null || echo __FULL__
    else
      echo __FULL__
    fi
  done)"
  scope="$(printf '%s\n' "$changed" | node "$repo/tools/prepush_scope.mjs" 2>/dev/null || echo FULL)"
fi
case "$scope" in
  "SUBSET "*) game="${scope#SUBSET }"; suite_desc="game '$game' subset (shared tests kept; other games skipped)"
    set -- node --test --test-concurrency=2 "core/**/test/*.test.js" "boards/**/test/*.test.js" \
      "games/$game/**/test/*.test.js" "tools/**/test/*.test.js" "web/test/*.test.js" ;;
  *) suite_desc="full suite"; set -- npm test ;;
esac
echo "[pre-push] running $suite_desc (hard cap ${SUITE_TIMEOUT}s) before push..." >&2
log="$(mktemp)"
if [ -n "$runner" ]; then
  "$runner" "$SUITE_TIMEOUT" "$@" >"$log" 2>&1 </dev/null; rc=$?
else
  "$@" >"$log" 2>&1 </dev/null; rc=$?
fi
if [ "$rc" -eq 0 ]; then
  rm -f "$log"
  # The suite passing HERE says nothing about a stranger, because we own the ROMs and they do
  # not. README's Quickstart promises the ROM-dependent tests skip cleanly without one, and nine
  # gates broke that promise -- four of them already pushed -- before anyone ran the only command
  # an outside reader ever runs. This clones the committed state (ROMs are gitignored, so the
  # clone has none) and runs the suite there; almost everything skips, so it is far cheaper.
  # It runs under GUARD_TIMEOUT, not SUITE_TIMEOUT -- a second `npm test` hangs the same ways.
  # The two caps are coupled (see above) and must not be re-merged.
  echo "[pre-push] suite green -- now checking a stranger's clone (no ROMs)..." >&2
  if [ -n "$runner" ]; then
    "$runner" "$GUARD_TIMEOUT" node tools/rom_guard_check.mjs >&2; grc=$?
  else
    node tools/rom_guard_check.mjs >&2; grc=$?
  fi
  if [ "$grc" -eq 124 ]; then
    echo "" >&2
    echo "PUSH BLOCKED -- the no-ROM clone check did not FINISH within ${GUARD_TIMEOUT}s." >&2
    echo "That is a TIMEOUT, not a red test. As with the suite above, rule out a too-small cap" >&2
    echo "FIRST: run 'time node tools/rom_guard_check.mjs' by hand and see whether it finishes." >&2
    echo "If it does, raise GUARD_TIMEOUT in hooks/pre-push -- but keep it BELOW the 900s bound" >&2
    echo "hardcoded in tools/rom_guard_check.mjs, or this branch stops being reachable." >&2
    exit 1
  fi
  if [ "$grc" -eq 0 ]; then
    echo "[pre-push] push allowed." >&2
    exit 0
  fi
  echo "" >&2
  echo "PUSH BLOCKED -- the suite is green for US and RED for anyone who clones it." >&2
  echo "Do not --no-verify: this is the first command the README tells a stranger to run." >&2
  exit 1
fi
echo "" >&2
if [ "$rc" -eq 124 ]; then
  echo "PUSH BLOCKED -- the suite did not FINISH within ${SUITE_TIMEOUT}s; it was killed." >&2
  echo "This is a TIMEOUT, not a red test. It has TWO causes and they look identical here:" >&2
  echo "  (a) the cap is too small for a suite that grew -- the run was HEALTHY and was killed;" >&2
  echo "  (b) an unbounded spin in a wired idiomatic routine, which the step budget cannot see." >&2
  echo "CHECK (a) FIRST -- it is cheaper to rule out, and this suite has been measured varying" >&2
  echo "more than 2x between runs of the same tree, so a cap that passed yesterday can kill a" >&2
  echo "green run today. Run 'time npm test' unbounded: if it finishes green, raise" >&2
  echo "SUITE_TIMEOUT in hooks/pre-push and record the load; do NOT hunt a spin." >&2
  echo "Only if it never finishes is it (b): find which test file stopped producing output in the" >&2
  echo "log named below, then run that file alone under 'timeout'." >&2
  # Kept on timeout only: a hang emits no ✖ and no summary, so the grep below shows nothing and
  # this log is the only thing that can answer (b).
  echo "" >&2
  echo "Suite output kept for diagnosis: $log" >&2
  echo "  tail -5 '$log'   # the last file to report before it stopped" >&2
  keep_log=1
else
  echo "PUSH BLOCKED -- npm test is RED. Fix the suite before pushing (do not --no-verify)." >&2
fi
grep -E '✖|^ℹ (tests|pass|fail)' "$log" | tail -25 >&2
[ -n "${keep_log:-}" ] || rm -f "$log"
exit 1
